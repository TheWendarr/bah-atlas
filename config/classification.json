{
  "_doc": "A13. Field meanings and the reasoning behind every value: docs/configuration.md#a13-classification-configclassificationjson. Validate with `make check-config`.",
  "version": 3,
  "coverage_target": 0.95,
  "no_data_color": "#bdbdbd",
  "palette_source": "ColorBrewer RdBu, 7 classes (colour-blind safe). Red = shortfall, blue = surplus, near-white = at the design point.",
  "default_metric": "adequacy_ratio",
  "metrics": {
    "adequacy_ratio": {
      "label": "Adequacy ratio ((BAH + member cost share) / local housing cost)",
      "short_label": "Adequacy",
      "role": "primary",
      "modes": ["rent", "buy"],
      "format": "percent",
      "method": "fixed",
      "neutral": 1.0,
      "breaks": [0.85, 0.92, 0.97, 1.03, 1.08, 1.15],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "Below 85%: far below the statutory design",
        "85-92%: well below design",
        "92-97%: below design",
        "97-103%: at the statutory design point",
        "103-108%: above design",
        "108-115%: well above design",
        "115% and above: far above design"
      ],
      "ramp_labels": ["under 85%", "100%", "115%+"],
      "off_standard": {
        "label": "How far BAH plus the member cost share goes toward this home",
        "short_label": "BAH + cost share covers",
        "neutral": 1.0,
        "breaks": [0.5, 0.7, 0.9, 1.1, 1.4, 1.8],
        "class_labels": [
          "Below 50%",
          "50-70%",
          "70-90%",
          "90-110%: about covers this home",
          "110-140%",
          "140-180%",
          "180% and above"
        ],
        "ramp_labels": ["under 50%", "100%", "180%+"]
      }
    },
    "design_gap_usd": {
      "label": "Monthly gap vs the statutory design (BAH + cost share - local housing cost)",
      "short_label": "Gap vs design",
      "role": "primary",
      "modes": ["rent", "buy"],
      "format": "usd",
      "method": "fixed",
      "neutral": 0,
      "breaks": [-500, -250, -50, 50, 250, 500],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "Short of design by over $500",
        "Short by $250-500",
        "Short by $50-250",
        "Within $50 of design",
        "Over by $50-250",
        "Over by $250-500",
        "Over by more than $500"
      ],
      "ramp_labels": ["short $500+", "$0", "over $500+"],
      "off_standard": {
        "label": "Monthly difference (BAH + cost share - local cost of this home)",
        "short_label": "Monthly difference",
        "neutral": 0,
        "breaks": [-2000, -1000, -300, 300, 1000, 2000],
        "class_labels": [
          "Short by over $2,000",
          "Short by $1,000-2,000",
          "Short by $300-1,000",
          "Within $300 of this home's cost",
          "Over by $300-1,000",
          "Over by $1,000-2,000",
          "Over by more than $2,000"
        ],
        "ramp_labels": ["short $2,000+", "$0", "over $2,000+"]
      }
    },
    "coverage_ratio": {
      "label": "Coverage ratio (BAH / local housing cost)",
      "short_label": "Coverage",
      "role": "descriptive",
      "modes": ["rent", "buy"],
      "format": "percent",
      "method": "fixed",
      "neutral": 0.95,
      "breaks": [0.85, 0.9, 0.94, 0.96, 1.0, 1.05],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "Below 85%: severe shortfall",
        "85-90%: shortfall",
        "90-94%: below target",
        "94-96%: at the 95% target",
        "96-100%: above target",
        "100-105%: full coverage",
        "105% and above: surplus"
      ],
      "ramp_labels": ["under 85%", "95%", "105%+"],
      "off_standard": {
        "label": "How far BAH alone goes toward this home",
        "short_label": "BAH alone covers",
        "neutral": 1.0,
        "breaks": [0.5, 0.7, 0.9, 1.1, 1.4, 1.8],
        "class_labels": [
          "Below 50%",
          "50-70%",
          "70-90%",
          "90-110%: about covers this home",
          "110-140%",
          "140-180%",
          "180% and above"
        ],
        "ramp_labels": ["under 50%", "100%", "180%+"]
      }
    },
    "surplus_usd": {
      "label": "Monthly surplus or gap (BAH - local housing cost)",
      "short_label": "Surplus / gap",
      "role": "descriptive",
      "modes": ["rent", "buy"],
      "format": "usd",
      "method": "fixed",
      "neutral": 0,
      "breaks": [-500, -250, -50, 50, 250, 500],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "Gap over $500",
        "Gap $250-500",
        "Gap $50-250",
        "Within $50 of full cost",
        "Surplus $50-250",
        "Surplus $250-500",
        "Surplus over $500"
      ],
      "ramp_labels": ["short $500+", "$0", "over $500+"],
      "off_standard": {
        "label": "BAH minus the local cost of this home",
        "short_label": "BAH minus cost",
        "neutral": 0,
        "breaks": [-2000, -1000, -300, 300, 1000, 2000],
        "class_labels": [
          "Short by over $2,000",
          "Short by $1,000-2,000",
          "Short by $300-1,000",
          "Within $300 of this home's cost",
          "Over by $300-1,000",
          "Over by $1,000-2,000",
          "Over by more than $2,000"
        ],
        "ramp_labels": ["short $2,000+", "$0", "over $2,000+"]
      }
    },
    "flat95_gap": {
      "label": "Flat-95% gap (BAH / local housing cost - 0.95)",
      "short_label": "Flat-95% gap",
      "role": "sensitivity",
      "modes": ["rent", "buy"],
      "format": "percent",
      "method": "fixed",
      "neutral": 0,
      "breaks": [-0.1, -0.05, -0.01, 0.01, 0.05, 0.1],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "More than 10 points below 95%",
        "5-10 points below 95%",
        "1-5 points below 95%",
        "Within 1 point of 95%",
        "1-5 points above 95%",
        "5-10 points above 95%",
        "More than 10 points above 95%"
      ],
      "ramp_labels": ["10+ points under", "95%", "10+ points over"]
    },
    "safmr_adequacy_ratio": {
      "label": "Adequacy ratio against HUD SAFMR ((BAH + member cost share) / SAFMR at the anchor bedroom count)",
      "short_label": "Adequacy (SAFMR)",
      "role": "sensitivity",
      "modes": ["rent"],
      "format": "percent",
      "method": "fixed",
      "neutral": 1.0,
      "breaks": [0.85, 0.92, 0.97, 1.03, 1.08, 1.15],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "Below 85%: far below the statutory design",
        "85-92%: well below design",
        "92-97%: below design",
        "97-103%: at the statutory design point",
        "103-108%: above design",
        "108-115%: well above design",
        "115% and above: far above design"
      ],
      "ramp_labels": ["under 85%", "100%", "115%+"]
    },
    "safmr_design_gap_usd": {
      "label": "Monthly gap vs the statutory design, against HUD SAFMR (BAH + cost share - SAFMR)",
      "short_label": "Gap vs design (SAFMR)",
      "role": "sensitivity",
      "modes": ["rent"],
      "format": "usd",
      "method": "fixed",
      "neutral": 0,
      "breaks": [-500, -250, -50, 50, 250, 500],
      "colors": ["#b2182b", "#ef8a62", "#fddbc7", "#f7f7f7", "#d1e5f0", "#67a9cf", "#2166ac"],
      "class_labels": [
        "Short of design by over $500",
        "Short by $250-500",
        "Short by $50-250",
        "Within $50 of design",
        "Over by $50-250",
        "Over by $250-500",
        "Over by more than $500"
      ],
      "ramp_labels": ["short $500+", "$0", "over $500+"]
    }
  },
  "clusters": {
    "variable": "adequacy_gap",
    "alpha": 0.05,
    "legend_title": "Local clusters (exploratory: pseudo p < 0.05, not corrected for multiple testing)",
    "out_of_scope_label": "Not part of the cluster analysis",
    "classes": {
      "HH": {
        "label": "Surplus cluster (high-high)",
        "color": "#2166ac"
      },
      "LL": {
        "label": "Shortfall cluster (low-low)",
        "color": "#b2182b"
      },
      "HL": {
        "label": "Surplus outlier among shortfalls (high-low)",
        "color": "#92c5de"
      },
      "LH": {
        "label": "Shortfall outlier among surpluses (low-high)",
        "color": "#f4a582"
      },
      "NS": {
        "label": "Not significant",
        "color": "#e0e0e0"
      }
    },
    "fdr_marker": {
      "label": "Still significant after the false-discovery-rate correction",
      "outline_color": "#000000",
      "outline_width": 2
    }
  }
}
